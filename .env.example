# ================================================================
# TUBARÕES CANSADOS - CONFIGURAÇÃO DE AMBIENTE (.env)
# ================================================================

# Porta do Servidor Web
PORT=3000

# Conexão com o Supabase (PostgreSQL)
# Obtenha em: Supabase -> Project Settings -> Database -> Connection string (URI)
# Exemplo com Connection Pooler (Recomendado):
# DATABASE_URL=postgresql://postgres.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Exemplo Conexão Direta:
# DATABASE_URL=postgresql://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres

# Chave Secreta para Sessão de Login (opcional, pode ser qualquer texto longo)
SESSION_SECRET=tubaroes_10_anos_chave_super_secreta_2026
